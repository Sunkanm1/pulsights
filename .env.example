# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# Which DataProvider backs the app. "seed" (default) uses local placeholder
# data and costs nothing — safe to leave as-is until a real source is chosen
# and approved. See src/lib/data-providers/*.
DATA_PROVIDER="seed"

# NGX Market Data API (https://marketdataapiv3.ngxgroup.com/portal) — requires
# registration; approval process / business registration not yet confirmed.
# NGX_API_KEY=
# NGX_API_BASE_URL=

# EODHD (eodhd.com) — paid. Confirm plan/cost before setting this.
# EODHD_API_KEY=

# RapidAPI "NGXEQTY" — unofficial, quote prototyping only.
# RAPIDAPI_KEY=
# RAPIDAPI_NGXEQTY_HOST=

# Shared secret for the Vercel Cron routes (src/app/api/cron/*). Vercel sets
# this automatically as an env var and sends it as a Bearer token on cron
# invocations — set the same value here so the route can verify the caller.
# CRON_SECRET=